# Use the same release tag for both application images.
NEXUSTIER_GATEWAY_IMAGE=ghcr.io/wuyouowo/nexustier:latest
NEXUSTIER_CONTROLLER_IMAGE=ghcr.io/wuyouowo/nexustier-controller:latest

# Replace both example secrets before starting the stack. URL-encode the database
# password in NEXUSTIER_CONTROLLER_DATABASE_URL if it contains reserved URL characters.
POSTGRES_DB=nexustier
POSTGRES_USER=nexustier
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEXUSTIER_CONTROLLER_DATABASE_URL=postgres://nexustier:replace-with-a-long-random-password@postgres:5432/nexustier?sslmode=disable
NEXUSTIER_GATEWAY_ADMISSION_TOKEN=replace-with-openssl-rand-hex-32

# Bind operational APIs to host loopback by default.
NEXUSTIER_GATEWAY_LISTEN_PORT=22020
NEXUSTIER_GATEWAY_API_BIND=127.0.0.1
NEXUSTIER_CONTROLLER_API_BIND=127.0.0.1

NEXUSTIER_GATEWAY_RPC_TIMEOUT_MS=5000
NEXUSTIER_GATEWAY_COLLECTION_TIMEOUT_MS=15000
NEXUSTIER_GATEWAY_MACHINE_CONCURRENCY=8
NEXUSTIER_GATEWAY_SNAPSHOT_TTL_MS=1000
RUST_LOG=info

NEXUSTIER_CONTROLLER_POLL_INTERVAL=15s
NEXUSTIER_CONTROLLER_POLL_JITTER=3s
NEXUSTIER_CONTROLLER_REQUEST_TIMEOUT=20s
NEXUSTIER_CONTROLLER_SHUTDOWN_TIMEOUT=10s
NEXUSTIER_CONTROLLER_METRIC_RETENTION=720h
NEXUSTIER_CONTROLLER_CLEANUP_INTERVAL=6h
NEXUSTIER_CONTROLLER_CLEANUP_BATCH_SIZE=10000